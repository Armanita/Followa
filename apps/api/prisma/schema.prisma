generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity: System Admin (platform) is fully separate from company users.
// ---------------------------------------------------------------------------

model SystemAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("system_admins")
}

model User {
  id                     String         @id @default(cuid())
  mobile                 String         @unique
  passwordHash           String?
  firstName              String
  lastName               String
  nationalId             String?
  birthDate              DateTime?
  phone                  String?
  address                String?
  maritalStatus          MaritalStatus?
  bankCardNumber         String?
  bankIban               String?
  bankName               String?
  profileFinalizedAt     DateTime?
  personnelPhotoFilename String?
  personnelPhotoPath     String?
  personnelPhotoMimeType String?
  personnelPhotoSize     Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  memberships    CompanyMembership[]
  assignedCases  Case[]              @relation("CaseCurrentOwner")
  createdCases   Case[]              @relation("CaseCreator")
  assignmentsTo  CaseAssignment[]    @relation("AssignmentToUser")
  assignmentsFrm CaseAssignment[]    @relation("AssignmentFromUser")
  workSessions   WorkSession[]
  reminders      Reminder[]          @relation("ReminderAssignee")
  createdRemind  Reminder[]          @relation("ReminderCreator")
  notifications  Notification[]
  activities     CaseActivity[]
  uploadedFiles  File[]
  auditActions   SensitiveAuditLog[] @relation("SensitiveAuditActor")
  telegramIdentity TelegramIdentity?

  @@map("users")
}

enum MaritalStatus {
  SINGLE
  MARRIED

  @@map("marital_status")
}

// ---------------------------------------------------------------------------
// Company & membership (role belongs to membership)
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       CompanyMembership[]
  caseTypes         CaseType[]
  cases             Case[]
  customers         Customer[]
  sensitiveAuditLog SensitiveAuditLog[]

  @@map("companies")
}

model CompanyMembership {
  id           String      @id @default(cuid())
  userId       String
  companyId    String
  role         CompanyRole
  isActive     Boolean     @default(true)
  jobTitle     String?
  employeeCode String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, isActive])
  @@map("company_memberships")
}

enum CompanyRole {
  COMPANY_MANAGER
  EMPLOYEE

  @@map("company_role")
}

// ---------------------------------------------------------------------------
// Sensitive audit trail (personnel + customer master data)
// ---------------------------------------------------------------------------

model SensitiveAuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String
  entityType String
  entityId   String
  action     String
  changes    Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User    @relation("SensitiveAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("sensitive_audit_logs")
}

// ---------------------------------------------------------------------------
// Customers (company-scoped master data; archived instead of deleted)
// ---------------------------------------------------------------------------

model Customer {
  id           String       @id @default(cuid())
  companyId    String
  type         CustomerType
  name         String
  mobile       String?
  phone        String?
  nationalId   String?
  economicCode String?
  email        String?
  address      String?
  notes        String?
  isActive     Boolean      @default(true)
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cases   Case[]

  @@index([companyId, isActive, name])
  @@index([companyId, type])
  @@index([companyId, mobile])
  @@index([companyId, nationalId])
  @@index([companyId, economicCode])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  LEGAL

  @@map("customer_type")
}

// ---------------------------------------------------------------------------
// Case engine
// ---------------------------------------------------------------------------

model CaseType {
  id        String  @id @default(cuid())
  companyId String
  name      String
  color     String?
  isActive  Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cases   Case[]

  @@unique([companyId, name])
  @@map("case_types")
}

model Case {
  id             String       @id @default(cuid())
  number         Int          @unique @default(autoincrement())
  companyId      String
  customerId     String?
  title          String
  description    String?
  caseTypeId     String?
  status         CaseStatus   @default(OPEN)
  priority       CasePriority @default(NORMAL)
  dueDate        DateTime?
  result         String?
  resultAt       DateTime?
  currentOwnerId String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company      Company          @relation(fields: [companyId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  caseType     CaseType?        @relation(fields: [caseTypeId], references: [id])
  currentOwner User?            @relation("CaseCurrentOwner", fields: [currentOwnerId], references: [id])
  createdBy    User             @relation("CaseCreator", fields: [createdById], references: [id])
  assignments  CaseAssignment[]
  activities   CaseActivity[]
  workSessions WorkSession[]
  reminders    Reminder[]
  files        File[]

  @@index([companyId, status])
  @@index([companyId, currentOwnerId])
  @@index([companyId, customerId])
  @@map("cases")
}

enum CaseStatus {
  OPEN
  WAITING_ACCEPTANCE
  IN_PROGRESS
  WAITING_APPROVAL
  DONE
  CANCELLED

  @@map("case_status")
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("case_priority")
}

model CaseAssignment {
  id           String           @id @default(cuid())
  caseId       String
  fromUserId   String?
  toUserId     String
  reason       AssignmentReason
  note         String?
  status       AssignmentStatus @default(PENDING)
  rejectReason String?
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())

  case   Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromUs User? @relation("AssignmentFromUser", fields: [fromUserId], references: [id])
  toUs   User  @relation("AssignmentToUser", fields: [toUserId], references: [id])

  @@index([caseId])
  @@index([toUserId, status])
  @@map("case_assignments")
}

enum AssignmentReason {
  INITIAL_ASSIGNMENT
  TRANSFER
  RETURN_AFTER_REJECT

  @@map("assignment_reason")
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("assignment_status")
}

model CaseActivity {
  id        String       @id @default(cuid())
  caseId    String
  actorId   String?
  type      ActivityType
  payload   Json?
  createdAt DateTime     @default(now())

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([caseId, createdAt])
  @@map("case_activities")
}

enum ActivityType {
  CREATE
  ASSIGN
  ACCEPT
  REJECT
  START_WORK
  END_WORK
  RESULT_ADDED
  FILE_UPLOADED
  COMPLETE
  CANCEL
  REMINDER_CREATED
  REMINDER_DONE

  @@map("activity_type")
}

// ---------------------------------------------------------------------------
// Work tracking
// ---------------------------------------------------------------------------

model WorkSession {
  id              String    @id @default(cuid())
  caseId          String
  userId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@index([caseId])
  @@map("work_sessions")
}

// ---------------------------------------------------------------------------
// Reminders
// ---------------------------------------------------------------------------

model Reminder {
  id          String         @id @default(cuid())
  caseId      String
  assigneeId  String
  creatorId   String
  remindAt    DateTime
  note        String?
  status      ReminderStatus @default(ACTIVE)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  case     Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee User @relation("ReminderAssignee", fields: [assigneeId], references: [id])
  creator  User @relation("ReminderCreator", fields: [creatorId], references: [id])

  @@index([assigneeId, status, remindAt])
  @@map("reminders")
}

enum ReminderStatus {
  ACTIVE
  DONE
  EXPIRED

  @@map("reminder_status")
}

// ---------------------------------------------------------------------------
// Files (local storage MVP)
// ---------------------------------------------------------------------------

model File {
  id          String   @id @default(cuid())
  caseId      String
  uploaderId  String
  filename    String
  storagePath String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  case     Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([caseId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Notifications (in-app; adapters for push/Bale/Eitaa come later)
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  linkType  String?
  linkId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationType {
  CASE_ASSIGNED
  CASE_ACCEPTED
  CASE_REJECTED
  REMINDER_DUE
  CASE_COMPLETED
  CASE_UPDATED

  @@map("notification_type")
}
model TelegramIdentity {
  id             String   @id @default(cuid())
  telegramUserId String   @unique
  userId         String   @unique
  phoneNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_identities")
}

