# dependencies
node_modules/
.pnpm-store/

# builds
dist/
.next/
out/
build/

# env & secrets
.env
.env.local
.env.*.local
*.pem

# storage (uploaded files) — runtime data, never versioned
storage/files/
apps/api/storage/
uploads/

# vendored pnpm seed tarballs for the production API image (~43 MB).
# Reproduce with scripts/fetch-pnpm-seed.sh (or .ps1) before a clean build.
docker/pnpm-seed/*
!docker/pnpm-seed/.gitkeep

# flutter / dart
apps/mobile/.dart_tool/
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.flutter-plugins*
apps/mobile/android/app/upload-keystore.*
**/GeneratedPluginRegistrant.*

# misc
*.log
.DS_Store
Thumbs.db
coverage/
.turbo/

# prisma client generated output is inside node_modules by default; keep migrations in VCS

# production env (filled on VM)
.env.prod
