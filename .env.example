# ---- Database ----
# Host port mapping is in docker-compose.yml (host 5433 -> container 5432)
DATABASE_URL="postgresql://followa:followa_dev_password@127.0.0.1:5433/followa?schema=public"

# ---- API ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT — replace with a long random string in any real deployment
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"
# Master key for encrypting provider credentials stored in PostgreSQL.
MESSAGING_CREDENTIALS_KEY="replace-with-at-least-32-random-characters"

# Initial system admin (used by seed script)
SYSTEM_ADMIN_USERNAME="admin"
SYSTEM_ADMIN_PASSWORD="admin1234"

# OTP provider: mock | telegram | sms | bale | eitaa
# telegram delivers codes to the user's linked Telegram account (TelegramIdentity);
# mock logs codes (dev/test default — no network access needed)
OTP_PROVIDER=mock

# Notification channels: mock | telegram | bale | eitaa
NOTIFICATION_PROVIDER=mock

# P8 multi-channel notification rollout. Both flags default to false so the
# legacy immediate sender remains unchanged after deployment.
MULTI_CHANNEL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5

# Telegram bot (identity linking + notification delivery)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Bale bot (secure identity linking only in P5; OTP/notifications stay unchanged)
# Keep disabled until the P3 migration is deployed and a test bot is ready.
BALE_LINKING_ENABLED=false
BALE_BOT_TOKEN=""
BALE_BOT_USERNAME=""
# At least 32 random characters. Register:
# https://YOUR_API/api/v1/bale/webhook/<BALE_WEBHOOK_SECRET>
BALE_WEBHOOK_SECRET=""

# File storage
STORAGE_DIR="./storage/files"
MAX_FILE_SIZE_MB=20

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
