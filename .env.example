# ---- Database ----
# Host port mapping is in docker-compose.yml (host 5433 -> container 5432)
DATABASE_URL="postgresql://followa:followa_dev_password@127.0.0.1:5433/followa?schema=public"

# ---- API ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# JWT — replace with a long random string in any real deployment
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"

# Initial system admin (used by seed script)
SYSTEM_ADMIN_USERNAME="admin"
SYSTEM_ADMIN_PASSWORD="admin1234"

# OTP provider: mock | telegram | sms | bale | eitaa
# telegram delivers codes to the user's linked Telegram account (TelegramIdentity);
# mock logs codes (dev/test default — no network access needed)
OTP_PROVIDER=mock

# Notification channels: mock | telegram | bale | eitaa
NOTIFICATION_PROVIDER=mock

# Telegram bot (identity linking + notification delivery)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# File storage
STORAGE_DIR="./storage/files"
MAX_FILE_SIZE_MB=20

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
