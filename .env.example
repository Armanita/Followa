# ---- Database ----
DATABASE_URL="postgresql://followa:followa_dev_password@127.0.0.1:5433/followa?schema=public"
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"
# Deployment-only master key for AES-GCM provider credentials. Never store provider tokens here.
MESSAGING_CREDENTIALS_KEY="replace-with-at-least-32-random-characters"
SYSTEM_ADMIN_USERNAME="admin"
SYSTEM_ADMIN_PASSWORD="admin1234"
# Embedded workers inside the API process (Render single-instance pattern).
# Keep false when a standalone worker container/process already runs this loop.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
# Set true only on a single Render API instance when no standalone reminder-due-worker is deployed.
REMINDER_DUE_WORKER_ENABLED=false
REMINDER_DUE_WORKER_POLL_MS=15000
REMINDER_DUE_WORKER_BATCH_SIZE=50
REMINDER_DUE_MAX_AGE_HOURS=24
# Bootstrap fallback only. Runtime configuration comes from MessagingSystemPolicy (System Admin). Leave empty after admin configuration.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
BALE_LINKING_ENABLED=false
BALE_BOT_TOKEN=""
BALE_BOT_USERNAME=""
BALE_WEBHOOK_SECRET=""
STORAGE_DIR="./storage/files"
MAX_FILE_SIZE_MB=20
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
