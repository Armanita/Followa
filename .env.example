# ---- Database ----
DATABASE_URL="postgresql://followa:followa_dev_password@127.0.0.1:5433/followa?schema=public"
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"
# Deployment-only master key for AES-GCM provider credentials. Never store provider tokens here.
MESSAGING_CREDENTIALS_KEY="replace-with-at-least-32-random-characters"
SYSTEM_ADMIN_USERNAME="admin"
SYSTEM_ADMIN_PASSWORD="admin1234"
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
# Linking webhook compatibility only. Delivery credentials are configured in System Admin.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
BALE_LINKING_ENABLED=false
BALE_BOT_TOKEN=""
BALE_BOT_USERNAME=""
BALE_WEBHOOK_SECRET=""
STORAGE_DIR="./storage/files"
MAX_FILE_SIZE_MB=20
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
