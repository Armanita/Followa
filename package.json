{
  "name": "followa",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "pnpm --filter @followa/api dev",
    "dev:web": "pnpm --filter @followa/web dev",
    "build:api": "pnpm --filter @followa/api build",
    "build:web": "pnpm --filter @followa/web build",
    "test": "pnpm --filter @followa/api test",
    "db:migrate": "pnpm --filter @followa/api db:migrate",
    "db:seed": "pnpm --filter @followa/api db:seed",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
