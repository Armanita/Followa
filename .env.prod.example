# Followa production/test environment — copy to .env on the VM and edit.
# NEVER commit the filled version.

# --- Postgres (compose-internal) ---
POSTGRES_USER=followa
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=followa

# --- API ---
# generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_EVEN_LONGER_RANDOM
JWT_EXPIRES_IN=12h
# generate: openssl rand -hex 32 (never enter provider tokens here)
MESSAGING_CREDENTIALS_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# mock logs codes (dev/test); telegram delivers to linked Telegram accounts
OTP_PROVIDER=mock
# mock keeps dev/test quiet; set to telegram to deliver via the linked bot
NOTIFICATION_PROVIDER=mock
# Enable only after P3/P6/P7 migrations, isolated tests and policy setup.
# When enabled, this replaces (not supplements) the legacy immediate sender.
MULTI_CHANNEL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
MAX_FILE_SIZE_MB=20
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=CHANGE_ME_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET

# --- Bale bot (identity linking only; independent from OTP/notifications) ---
# Enable only after the P3 migration and isolated acceptance tests.
BALE_LINKING_ENABLED=false
BALE_BOT_TOKEN=CHANGE_ME_BALE_BOT_TOKEN
BALE_BOT_USERNAME=CHANGE_ME_BALE_BOT_USERNAME
# generate: openssl rand -hex 32
# setWebhook URL: https://YOUR_DOMAIN/api/v1/bale/webhook/<this value>
BALE_WEBHOOK_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# --- Reverse proxy / TLS ---
# With a real DNS A-record pointing at the VM:
#   WEB_DOMAIN=app.yourdomain.com
#   API_DOMAIN=api.yourdomain.com
# Caddy then issues Let's Encrypt certificates automatically.
# Without a domain (IP-only testing), leave both as ":80" — plain HTTP.
WEB_DOMAIN=:80
API_DOMAIN=:80
