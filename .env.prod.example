# Followa production/test environment — copy to .env on the VM and edit.
# NEVER commit the filled version.

# --- Postgres (compose-internal) ---
POSTGRES_USER=followa
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=followa

# --- API ---
# generate: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_EVEN_LONGER_RANDOM
JWT_EXPIRES_IN=12h
OTP_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
MAX_FILE_SIZE_MB=20
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Reverse proxy / TLS ---
# With a real DNS A-record pointing at the VM:
#   WEB_DOMAIN=app.yourdomain.com
#   API_DOMAIN=api.yourdomain.com
# Caddy then issues Let's Encrypt certificates automatically.
# Without a domain (IP-only testing), leave both as ":80" — plain HTTP.
WEB_DOMAIN=:80
API_DOMAIN=:80
