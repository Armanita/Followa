# Copy to .env and edit; never commit a filled copy.
POSTGRES_USER=followa
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=followa
JWT_SECRET=CHANGE_ME_EVEN_LONGER_RANDOM
JWT_EXPIRES_IN=12h
# Only deployment master key. Provider tokens are configured in System Admin.
MESSAGING_CREDENTIALS_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Set true only on a single Render API instance when no standalone worker is deployed.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
REMINDER_DUE_WORKER_POLL_MS=15000
REMINDER_DUE_WORKER_BATCH_SIZE=50
REMINDER_DUE_MAX_AGE_HOURS=24
TZ=Asia/Tehran
MAX_FILE_SIZE_MB=20
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Bootstrap fallback only. Runtime configuration comes from MessagingSystemPolicy (System Admin).
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_LINKING_TOKEN
TELEGRAM_BOT_USERNAME=CHANGE_ME_TELEGRAM_BOT_USERNAME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET
BALE_LINKING_ENABLED=false
BALE_BOT_TOKEN=CHANGE_ME_BALE_LINKING_TOKEN
BALE_BOT_USERNAME=CHANGE_ME_BALE_BOT_USERNAME
BALE_WEBHOOK_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_DOMAIN=:80
API_DOMAIN=:80
